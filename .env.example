# Copy to .env.local and fill in. Never commit real values or paste them in chat.

# Public URL of the deployment (used in report links and the Telegram webhook)
NEXT_PUBLIC_SITE_URL=

# Morning Report writer (falls back to built-in templates if unset)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Postgres (Neon). Unset = local JSON file under .data/ (dev only)
DATABASE_URL=

# Optional: higher PageSpeed Insights quota
PSI_API_KEY=

# Protects /api/cron/night-watch (Vercel Cron sends it automatically) and the Telegram setup route
CRON_SECRET=

# Email delivery via Brevo (both required to enable)
BREVO_API_KEY=
MAIL_FROM=

# Telegram delivery (all three required to enable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
